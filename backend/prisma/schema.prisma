generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  APPLICANT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  fullName      String         @map("full_name") @db.VarChar(120)
  nationalId    String         @unique @map("national_id") @db.VarChar(30)
  email         String         @unique @db.VarChar(160)
  passwordHash  String         @map("password_hash")
  role          Role           @default(APPLICANT)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  applicantRequests CreditRequest[] @relation("ApplicantRequests")
  createdRequests CreditRequest[] @relation("CreatedRequests")
  reviewedRequests CreditRequest[] @relation("ReviewedRequests")

  @@index([role, isActive])
  @@map("users")
}

model CreditRequest {
  id              String        @id @default(uuid()) @db.Uuid
  requestNumber   String        @unique @map("request_number") @db.VarChar(30)
  applicantId     String        @map("applicant_id") @db.Uuid
  createdById     String        @map("created_by") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  termMonths      Int           @map("term_months") @db.SmallInt
  status          RequestStatus @default(PENDING)
  decisionComment String?       @map("decision_comment") @db.VarChar(1000)
  reviewedById    String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  applicant       User          @relation("ApplicantRequests", fields: [applicantId], references: [id], onDelete: Restrict)
  createdBy       User          @relation("CreatedRequests", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy      User?         @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([applicantId])
  @@index([status, createdAt(sort: Desc)])
  @@map("credit_requests")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  tokenFamily String    @default(uuid()) @map("token_family") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  rotatedAt   DateTime? @map("rotated_at")
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}
